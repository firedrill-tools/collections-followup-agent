{
  "name": "collections-followup-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-argparse.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run test && node dist/src/cli.js --help",
    "collections": "node dist/src/cli.js",
    "datasets:check": "npm run build && node scripts/build-datasets.mjs --check",
    "package": "npm run build && node scripts/package.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.88",
    "@mastra/core": "1.77.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gray-matter@4": {
      "js-yaml@3": {
        "argparse": "2.0.1"
      }
    }
  },
  "bin": {
    "collections": "dist/src/cli.js"
  }
}
